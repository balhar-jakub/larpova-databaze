# ── Local development example ──────────────────────────────
# Copy this file to packages/web/.env and fill in your local values.
# Never commit the real .env — only this .example template.

# PostgreSQL connection. Schema defaults to 'public' for prod, 'csld_test' for the test server.
DATABASE_URL=postgresql://csld:csld@localhost:5433/csld
DATABASE_URL_SSL=postgresql://csld:csld@localhost:5433/csld

# File storage. Local directory where uploaded game covers and user avatars land.
CSLD_DATA_SOURCE=local
CSLD_DATA_DIR=/tmp/csld-files

# Server port.
PORT=8080

# Production mode — MUST be 'production' in deployed environments.
# Without this, Next.js renders pages on demand (slow + untranslated SSR).
NODE_ENV=production

# ── Mail (magic-link auth) ─────────────────────────────────
# Gmail SMTP works for both dev and prod. Create a Google App Password
# (https://myaccount.google.com/apppasswords) and put it in MAIL_PASSWORD.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=larpovadatabaze@gmail.com
MAIL_PASSWORD=replace-me-with-google-app-password
MAIL_FROM=larpovadatabaze@gmail.com
