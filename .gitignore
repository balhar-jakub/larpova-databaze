# Dependencies
node_modules/
**/node_modules/

# Build outputs
.next/
**/.next/
dist/
**/dist/
*.tsbuildinfo
**/*.tsbuildinfo

# GraphQL codegen output — generated by `yarn codegen` (packages/web) and by
# CI/deploy workflows; never hand-edited, so it does not belong in the repo.
packages/web/src/graphql/__generated__/

# Environment & secrets — never commit credentials
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
